RewriteEngine On

# 1. Route /services/{slug} to services/index.php?slug={slug}
# Prevents redirect loop if requesting services or services/ directly
RewriteRule ^services/?$ services/index.php [L,QSA]
RewriteRule ^services/([a-zA-Z0-9_-]+)/?$ services/index.php?slug=$1 [L,QSA]

# 2. Allow existing real files and folders to load directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Custom 404 Error Document
ErrorDocument 404 /404.php

# 4. Fallback rewrite rule for missing routes to 404.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]